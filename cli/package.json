{
  "name": "@hoplet/cli",
  "description": "The hoplet command: sessions, attach, send and wait for a Hoplet core",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hoplet": "./src/main.ts"
  },
