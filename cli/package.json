    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hoplet/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
